[sub_resource type="Shader" id="DangerShader"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec4 base = COLOR;\n\tvec2 p = UV * 2.0 - 1.0;\n\tfloat edge = smoothstep(0.48, 1.02, length(p * vec2(0.72, 1.0)));\n\tfloat corners = smoothstep(0.62, 1.18, length(p));\n\tfloat mask = max(edge, corners);\n\tfloat danger_alpha = base.a * mask;\n\tfloat quiet_vignette = mask * 0.075;\n\tvec3 quiet_tint = vec3(0.018, 0.026, 0.045);\n\tvec3 tint = mix(quiet_tint, base.rgb, clamp(base.a * 2.4, 0.0, 1.0));\n\tCOLOR = vec4(tint, max(quiet_vignette, danger_alpha));\n}\n"

[sub_resource type="ShaderMaterial" id="DangerMaterial"]
