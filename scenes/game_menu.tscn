[sub_resource type="Shader" id="Shader_background"]
code = "shader_type canvas_item;\n\nuniform sampler2D background : source_color, filter_linear_mipmap_anisotropic;\nuniform float motion_value = 0.0;\n\nfloat hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }\n\nvoid fragment() {\n\tvec2 p = UV;\n\tfloat drift_x = sin(motion_value * 0.11) * 0.0035;\n\tfloat drift_y = cos(motion_value * 0.09) * 0.0025;\n\tfloat breathing_zoom = 0.985 + sin(motion_value * 0.08) * 0.003;\n\tvec2 scene_uv = (p - 0.5) * breathing_zoom + 0.5 + vec2(drift_x, drift_y);\n\tvec3 color = texture(background, scene_uv).rgb;\n\tfloat lower_shade = smoothstep(0.34, 0.98, p.y);\n\tcolor = mix(color, color * vec3(0.58, 0.50, 0.46), lower_shade * 0.52);\n\tfloat vignette = smoothstep(0.36, 0.80, distance(p, vec2(0.5, 0.48)));\n\tcolor *= 1.0 - vignette * 0.28;\n\tcolor += vec3(0.018, 0.010, 0.002) * smoothstep(0.55, 1.0, p.y);\n\tcolor += (hash(floor(p * vec2(1280.0, 720.0))) - 0.5) * 0.006;\n\tCOLOR = vec4(color, 1.0);\n}"

[sub_resource type="ShaderMaterial" id="Material_background"]
shader = SubResource("Shader_background")
shader_parameter/background = ExtResource("2_background")
shader_parameter/motion_value = 0.0

